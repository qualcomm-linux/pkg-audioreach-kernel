PACKAGE_NAME="audioreach-kernel"
PACKAGE_VERSION="#MODULE_VERSION#"

BUILT_MODULE_NAME[0]="audioreach-driver"
DEST_MODULE_LOCATION[0]="/updates/dkms"

AUTOINSTALL="yes"
BUILD_EXCLUSIVE_CONFIG="CONFIG_VFIO"
BUILD_EXCLUSIVE_KERNEL_MIN="6.18"

MAKE[0]="make -C ${kernel_source_dir} M=${dkms_tree}/${PACKAGE_NAME}/${PACKAGE_VERSION}/build/audioreach-driver modules"
CLEAN="make -C ${kernel_source_dir} M=${dkms_tree}/${PACKAGE_NAME}/${PACKAGE_VERSION}/build/audioreach-driver clean"
